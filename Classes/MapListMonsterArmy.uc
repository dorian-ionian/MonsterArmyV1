//=============================================================================
// MapListMonsterArmy
// The Onslaught battlefields the war plays on. The gametype only plays
// ONS-* maps; when bOnlyONSMaps is enabled it also refuses anything
// outside this list.
//=============================================================================
class MapListMonsterArmy extends MapList
    config;

defaultproperties
{
     Maps(0)="ONS-Adara"
     Maps(1)="ONS-ArcticStronghold"
     Maps(2)="ONS-Crossfire"
     Maps(3)="ONS-Dawn"
     Maps(4)="ONS-Dria"
     Maps(5)="ONS-FrostBite"
     Maps(6)="ONS-IslandHop"
     Maps(7)="ONS-Primeval"
     Maps(8)="ONS-RedPlanet"
     Maps(9)="ONS-Severance"
     Maps(10)="ONS-Torlan"
     Maps(11)="ONS-Tricky"
     Maps(12)="ONS-Urban"
}
